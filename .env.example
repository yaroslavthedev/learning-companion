# Local development settings. Create your own copy once:
#   cp -n .env.example .env
# These are dev-only placeholders. Never commit .env, never put real secrets here.

# Django
SECRET_KEY=change-me-dev-only-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres container (docker compose up -d db), published on host port 5433
POSTGRES_USER=learning
POSTGRES_PASSWORD=change-me
POSTGRES_DB=learning_companion
DATABASE_URL=postgres://learning:change-me@localhost:5433/learning_companion

# Optional: read settings from a different env file instead of .env
# DJANGO_ENV_FILE=
