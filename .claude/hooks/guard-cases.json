  {"cmd": "git commit -n -m x", "expect": "deny"},
  {"cmd": "git push --no-verify -u origin HEAD", "expect": "deny"},
  {"cmd": "git push -n origin HEAD", "expect": "allow"},
  {"cmd": "git commit -m x && grep -rn no-verify .claude", "expect": "allow"},
  {"cmd": "cat > body.md <<EOF\nnever use git commit --no-verify\nEOF\ngh pr create --body-file body.md", "expect": "allow"},
  {"cmd": "cat > body.md <<EOF\n- deny `git add -f`; and git push --force is blocked on main\nEOF\ngh pr create --body-file body.md", "expect": "allow"},
  {"cmd": "cat > x.md <<'EOF'\nharmless text\nEOF\ngit push --force", "expect": "deny"},
